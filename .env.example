PORT=3023
# Comma separated list when more than one site origin needs access.
FRONTEND_ORIGIN=http://localhost:3022

# There is only one database: production MySQL on Coolify.
# Locally, start the SSH tunnel first (`npm run db:tunnel`) and keep it running:
DATABASE_URL="mysql://mysql:password@127.0.0.1:13306/default"
# In Coolify, point it at the container on the internal network instead:
# DATABASE_URL="mysql://mysql:password@<mysql-container>:3306/default"

# Image uploads. Story images are written to s3://$AWS_S3_BUCKET/mi-images/{uuid}.ext
# and served from CLOUDFRONT_URL. Leave blank to disable uploads.
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
CLOUDFRONT_URL=
